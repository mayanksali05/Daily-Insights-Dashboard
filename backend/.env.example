# Copy to .env and adjust
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=daily_command_center

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Default weather location (Open-Meteo, no API key needed)
WEATHER_CITY=Ahmedabad

# Gold/silver: import duty added to the converted international price (India: 15% since May 2026).
# Update this if the government changes the rate. GST is not included.
IMPORT_DUTY_PERCENT=15

# Cache lifetimes (seconds)
CACHE_TTL_WEATHER=900
CACHE_TTL_MARKETS=60
CACHE_TTL_NEWS=600
CACHE_TTL_NOTION=30

# Notion: each user connects their own in Settings. Optional: a token here is copied
# into the FIRST account when it's created.
NOTION_TOKEN=
# Page (or database) whose amounts are totalled for the current month: its title, or its Notion URL
NOTION_EXPENSES_PAGE=Expenses
TIMEZONE=Asia/Kolkata

# AI Daily Brief: "extractive" (built in) or "llm" (implement in services/brief.py)
BRIEF_PROVIDER=extractive
# Reserved for the future LLM provider - never exposed to the frontend
LLM_API_KEY=

# Accounts: the first sign-up needs no code and becomes the owner.
# Others need this invite code; leave empty to close sign-ups.
SIGNUP_CODE=
# Long random string that signs sessions and encrypts stored Notion keys
# (Render generates one automatically). Don't change it once set.
SECRET_KEY=
