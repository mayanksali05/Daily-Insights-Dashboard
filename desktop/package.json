{
  "name": "daily-command-center-widget",
  "productName": "Daily Command Center",
  "version": "1.0.0",
  "description": "Desktop widget for the Daily Command Center dashboard",
  "author": "Mayank",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dailycommandcenter.widget",
    "productName": "Daily Command Center",
    "files": [
      "main.js",
      "media.js",
      "preload.js",
      "media/**",
      "config.json",
      "pages/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Daily Command Center",
      "artifactName": "DailyCommandCenter-Setup-${version}.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mayanksali05/Daily-Insights-Dashboard.git"
  },
  "homepage": "https://github.com/mayanksali05/Daily-Insights-Dashboard"
}
